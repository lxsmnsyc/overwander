# Supabase project config (public by design): Supabase dashboard ->
# project settings -> API. Copy to .env and fill in. For local
# development, `supabase start` prints all of these; the local
# defaults below work out of the box.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# The overworld seed every player shares; defaults to 'overworld'
VITE_WORLD_SEED=

# Server only. The privileged writes travel over a direct Postgres
# connection as the table owner, which is what lets them bypass RLS
# the way the admin SDK bypassed the rules. Hosted projects should
# point this at the transaction-mode pooler (port 6543).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server only: where the server verifies tokens and reaches the auth
# admin API. Same origin the browser uses.
SUPABASE_URL=http://127.0.0.1:54321

# Server only, and secret: the service-role key, used solely for auth
# admin calls (looking a player up by email, the admin dashboard).
# Without it those calls refuse; everything else runs without it.
SUPABASE_SERVICE_ROLE_KEY=

# Server only: how requireUid checks a token's signature without a
# round trip. Local stacks sign with this shared secret; leave it
# empty against a hosted project and the server fetches the JWKS
# instead.
SUPABASE_JWT_SECRET=
