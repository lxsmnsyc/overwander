# The environment every test suite runs under, in place of the root
# .env: Vitest, the database suite and the e2e dev server all read
# this directory instead, so a developer's own seed, world or sprite
# host never changes what a test sees. Each value here is the default
# the suites are written against; leave them empty unless a suite
# needs otherwise.

# The default world
VITE_WORLD_SEED=
VITE_WORLD_GENERATION=

# Sprites and sounds from this origin
VITE_SPRITE_ORIGIN=

# The game clock, not the player's local one
VITE_REAL_TIME_OF_DAY=
VITE_TIME_OF_DAY_MINUTES=
