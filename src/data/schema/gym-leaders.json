{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gym leaders",
  "type": "object",
  "propertyNames": {
    "$ref": "names.json#/definitions/gym-leader"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "type": {
        "$ref": "names.json#/definitions/type",
        "description": "What they field"
      },
      "badge": {
        "$ref": "names.json#/definitions/award",
        "description": "What beating them pays"
      },
      "sheets": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "The charsets they are seen in"
      },
      "prize": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Coats the badge pays that they are never seen in"
      },
      "later": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Coats that also ask for the next league's crown"
      },
      "signature": {
        "$ref": "names.json#/definitions/species",
        "description": "Their ace, standing sixth"
      }
    },
    "required": [
      "type",
      "badge",
      "sheets",
      "signature"
    ],
    "additionalProperties": false
  }
}
