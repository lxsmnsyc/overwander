{
  "name": "overwander",
  "version": "4.28.0",
  "private": true,
  "type": "module",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/sprite-stamps.ts && node scripts/sound-stamps.ts && vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "preview": "vite preview",
    "compact-sprites": "node scripts/compact-sprites.ts",
    "sprite-coats": "node scripts/sprite-coats.ts",
    "frontier-symbols": "node scripts/frontier-symbols.ts",
    "apricorn-trees": "node scripts/apricorn-trees.ts",
    "item-icons": "node scripts/item-icons.ts",
    "family-candies": "node scripts/family-candies.ts",
    "import-sprites": "node scripts/import-sprites.ts",
    "sprite-stamps": "node scripts/sprite-stamps.ts",
    "sound-stamps": "node scripts/sound-stamps.ts",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ai:sim": "vitest run --config vitest.sim.ts",
    "cs:ver": "changeset version",
    "cs:pub": "changeset publish",
    "cs:tag": "node scripts/tag-release.ts",
    "cs:add": "changeset add",
    "db": "docker compose -f compose.dev.yaml up --detach --wait",
    "db:stop": "docker compose -f compose.dev.yaml stop",
    "db:reset": "docker compose -f compose.dev.yaml down && pnpm db && pnpm db:migrate",
    "db:migrate": "node --env-file=.env.development scripts/migrate.ts",
    "db:password-link": "node --env-file=.env.development scripts/password-link.ts",
    "seed": "node --env-file=.env.development scripts/seed-dev.ts",
    "migrate": "node --env-file=.env scripts/migrate.ts",
    "password-link": "node --env-file=.env scripts/password-link.ts",
    "server": "pnpm build && docker compose --profile server up --detach --build",
    "server:tunnel": "docker compose --profile server up --detach tunnel",
    "server:tunnel:restart": "docker compose --profile server restart tunnel",
    "server:ps": "docker compose --profile server ps",
    "server:logs": "docker compose --profile server logs --follow"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.6",
    "@floating-ui/dom": "^1.8.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.5",
    "better-auth": "^1.7.6",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "solid-floating-ui": "^1.0.1",
    "solid-js": "^1.9.15",
    "solid-marked": "^0.8.0",
    "terracotta": "^1.3.0",
    "three": "^0.186.1",
    "uqr": "^0.1.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@lxsmnsyc/oxlint-config": "^0.1.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-solid-marked": "^0.8.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.7.0"
}
