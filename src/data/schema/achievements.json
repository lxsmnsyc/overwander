{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Achievements",
  "type": "object",
  "properties": {
    "lines": {
      "type": "object",
      "propertyNames": {
        "$ref": "names.json#/definitions/achievement-line"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "metric": {
            "$ref": "names.json#/definitions/metric",
            "description": "The lifetime counter it climbs"
          },
          "npc": {
            "$ref": "names.json#/definitions/npc"
          },
          "landmark": {
            "$ref": "names.json#/definitions/quest-landmark"
          },
          "tiers": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "Bronze, Silver, Gold and Platinum, ascending"
          }
        },
        "required": [
          "metric",
          "tiers"
        ],
        "additionalProperties": false
      }
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "names.json#/definitions/type"
      },
      "description": "The type lines, in the order the shelf shows them"
    },
    "type-tiers": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "Bronze, Silver, Gold and Platinum, ascending"
    },
    "trainer-tiers": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "Bronze, Silver, Gold and Platinum, ascending"
    },
    "colors": {
      "type": "object",
      "propertyNames": {
        "$ref": "names.json#/definitions/achievement-tier"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Each metal's colour"
    }
  },
  "required": [
    "lines",
    "types",
    "type-tiers",
    "trainer-tiers",
    "colors"
  ],
  "additionalProperties": false
}
