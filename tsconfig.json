{
  "exclude": ["node_modules"],
  "include": ["src", "types", "test", "e2e", "scripts", "playwright.config.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["@solidjs/start/env", "@types/node"],
    "importHelpers": true,
    "declaration": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "skipLibCheck": true,
    "paths": {
      "~/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "target": "ESNext",
    "useDefineForClassFields": false
  }
}
