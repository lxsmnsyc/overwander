{
  "exclude": ["node_modules"],
  "include": ["src", "types", "test", "e2e", "scripts", "db", "playwright.config.ts"],
  "contentMappers": [
    { "package": "@overwander/yaml-content-mapper", "extensions": [".yaml"] }
  ],
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@types/node"],
    "importHelpers": true,
    "declaration": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "skipLibCheck": true,
    "paths": {
      "~/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "target": "ESNext",
    "useDefineForClassFields": false
  }
}
