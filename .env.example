# Offer an address and a password beside the Google and GitHub
# buttons. Off unless this is exactly 1 or true; a development build
# offers them either way. A self-hosted game with no OAuth apps of its
# own wants it on.
VITE_EMAIL_SIGN_IN=

# Where the sprites are served from. Empty means this origin, which is
# what development and a self-hosted build both want; the live game
# points it at the host that publishes public/sprites.
VITE_SPRITE_ORIGIN=

# The overworld seed every player shares; defaults to 'overworld'
VITE_WORLD_SEED=

# Which generation that world is built with: 2 for the second, left
# empty for the first. Towns, seats, positions and claims are kept per
# generation, so switching hides the other world's rather than moving them
VITE_WORLD_GENERATION=

# false (the default, also when empty): the time of day runs on a game
# clock, where each of the four periods (morning, day, evening, night)
# lasts VITE_TIME_OF_DAY_MINUTES, 90 when empty, so a whole day passes in
# 6 hours. true: it follows each player's local clock instead
VITE_REAL_TIME_OF_DAY=false
VITE_TIME_OF_DAY_MINUTES=90

# The database's password. compose.yaml gives it to Postgres, and the
# app inside compose connects with it. Locally anything works; on the
# server make it long and random.
POSTGRES_PASSWORD=postgres

# Server only. Every read and write, accounts included, travels over
# this Postgres connection as the table owner. Inside compose the app
# is pointed at the `db` service instead; this one is for the tools run
# on the host (`pnpm migrate`, `pnpm seed`) and for `pnpm dev`.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/overwander

# Server only, and secret: what Better Auth signs sessions with. Any
# long random string, e.g. `openssl rand -base64 32`. Changing it signs
# everybody out.
BETTER_AUTH_SECRET=

# Server only: the origin players open, which sign-in redirects and
# OAuth callbacks are built on. The dev server's own origin locally.
BETTER_AUTH_URL=http://localhost:3000

# Server only: the OAuth apps. Signing in with a provider works only
# when both of its values are set. Each app's callback is
# <BETTER_AUTH_URL>/api/auth/callback/google (or /github).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server only. Record keeping a server may leave out, each off unless
# it is exactly 1 or true. See docs/deploy/operating.md.
# Every change to gold, items and candy, one row each
ECONOMY_LEDGER=
# Releases held for a day, and taken back for the candy they paid
RELEASE_GRACE=
# Every change staff make: roles, bans, gifts and teleports
STAFF_LOG=

# The server host only: the token of the Cloudflare tunnel compose.yaml
# runs in front of the app. See docs/deploy/server.md. Unused locally.
TUNNEL_TOKEN=

# The server host only: the R2 bucket scripts/backup.sh copies each
# nightly dump to, and a Cloudflare token that may write to it. Without
# a bucket the dumps stay on the machine. See docs/deploy/server.md.
BACKUP_BUCKET=
CLOUDFLARE_API_TOKEN=
