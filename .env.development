# Development's settings. `pnpm dev` reads them over the root .env, which
# is production's, so every value that reaches data, accounts or sign-in
# is set here and none of production's gets through. The world itself
# (seed, generation, sprite host) is not set, so development shows the
# same world as the live game.
#
# Personal changes go in .env.development.local, which git ignores.

# The throwaway database `pnpm db` starts (compose.dev.yaml)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54324/overwander_dev

# Development's own signing secret and origin
BETTER_AUTH_SECRET=development-only-secret-not-used-anywhere-else
BETTER_AUTH_URL=http://localhost:3000

# No OAuth apps: a development build signs in with an address and a password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Production's own, which development never needs
POSTGRES_PASSWORD=
TUNNEL_TOKEN=
BACKUP_BUCKET=
CLOUDFLARE_API_TOKEN=
