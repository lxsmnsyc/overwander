{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Battle: multi-hit",
  "type": "object",
  "propertyNames": {
    "$ref": "names.json#/definitions/move"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "min": {
        "type": "integer",
        "minimum": 1
      },
      "max": {
        "type": "integer",
        "minimum": 1
      },
      "escalating": {
        "const": true,
        "description": "Each strike lands harder than the last"
      }
    },
    "required": [
      "min",
      "max"
    ],
    "additionalProperties": false
  }
}
