{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NPC words",
  "type": "object",
  "propertyNames": {
    "$ref": "names.json#/definitions/npc"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "What they are called"
      },
      "description": {
        "type": "string",
        "description": "What they are for, in a line"
      },
      "quote": {
        "type": "string",
        "description": "What they open with"
      },
      "spent": {
        "type": "string",
        "description": "What they say once their one visit this window is spent"
      }
    },
    "required": [
      "name",
      "description",
      "quote"
    ],
    "additionalProperties": false
  }
}
