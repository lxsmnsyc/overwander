{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Legends",
  "type": "object",
  "propertyNames": {
    "$ref": "names.json#/definitions/legend"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "honor": {
        "$ref": "names.json#/definitions/award",
        "description": "The mark beating them pays"
      },
      "sheets": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "The charsets they are seen in"
      },
      "prize": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Coats the mark unlocks"
      },
      "party": {
        "type": "array",
        "items": {
          "$ref": "names.json#/definitions/species"
        },
        "minItems": 6,
        "maxItems": 6,
        "description": "Their own six"
      }
    },
    "required": [
      "honor",
      "sheets",
      "prize",
      "party"
    ],
    "additionalProperties": false
  }
}
