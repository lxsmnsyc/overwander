{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Regions",
  "type": "object",
  "propertyNames": {
    "$ref": "names.json#/definitions/region"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "dex": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0
        },
        "minItems": 2,
        "maxItems": 2,
        "description": "The first and last dex number it covers"
      },
      "milestones": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0
        },
        "description": "How many of its own each rung of its dex chain asks for"
      },
      "medal": {
        "$ref": "names.json#/definitions/award",
        "description": "What the last rung hangs on the shelf"
      }
    },
    "required": [
      "dex"
    ],
    "additionalProperties": false
  }
}
