# Firebase web app config (public by design): Firebase console ->
# project settings -> your web app. Copy to .env and fill in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# The overworld seed every player shares; defaults to 'overworld'
VITE_WORLD_SEED=

# Server only, and secret: the service account the privileged writes
# run as. Firebase console -> project settings -> service accounts ->
# generate new private key, then paste the whole JSON on one line.
# Leave it empty to fall back to application default credentials
# (GOOGLE_APPLICATION_CREDENTIALS, or a Google-hosted runtime).
#
# Without it, every write refuses: catches, gold, items, candy,
# evolutions, landmark claims and raid rewards all go through
# src/server/* and none of them can reach Firestore unauthenticated.
FIREBASE_SERVICE_ACCOUNT=

# --- Local emulators ---------------------------------------------
#
# Uncomment the block below and run `pnpm emulators` in another
# terminal to develop against a local Firebase instead of a project.
# Nothing above needs filling in for it, and it does not matter that
# the web config is blank: an emulated run fills in its own, since a
# "demo-" project runs entirely offline and the emulators check none
# of it. No account to hold, no key to leak, nothing a mistake costs.
#
# The unprefixed variables are read by the admin SDK itself, which is
# what points the privileged writes at the local ports; the prefixed
# one is the browser's half of the same decision. Both halves default
# to the same project id, so neither has to be named — name both, or
# neither, if you want a different one.
#
# VITE_FIREBASE_EMULATOR=true
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_PROJECT_ID=demo-poketerra
