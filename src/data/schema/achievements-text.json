{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Achievement words",
  "type": "object",
  "properties": {
    "tiers": {
      "type": "object",
      "propertyNames": {
        "$ref": "names.json#/definitions/achievement-tier"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "lines": {
      "type": "object",
      "propertyNames": {
        "$ref": "names.json#/definitions/achievement-line"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "What the line is called, and its title"
          },
          "deed": {
            "type": "string",
            "description": "What it counts, for the hover card"
          }
        },
        "required": [
          "name",
          "deed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tiers",
    "lines"
  ],
  "additionalProperties": false
}
