{
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "biome.enabled": false,
  "prettier.enable": false,
  "yaml.schemas": {
    "./src/data/schema/species-world.json": "src/data/species/world/**/*.yaml",
    "./src/data/schema/species-stats.json": "src/data/species/stats/**/*.yaml",
    "./src/data/schema/species-abilities.json": "src/data/species/abilities/**/*.yaml",
    "./src/data/schema/species-learnsets.json": "src/data/species/learnsets/**/*.yaml",
    "./src/data/schema/species-text.json": "src/data/text/*/species/**/*.yaml",
    "./src/data/schema/moves-battle.json": "src/data/moves/battle/**/*.yaml",
    "./src/data/schema/moves-cast.json": "src/data/moves/cast/**/*.yaml",
    "./src/data/schema/moves-text.json": "src/data/text/*/moves/**/*.yaml",
    "./src/data/schema/abilities-text.json": "src/data/text/*/abilities/**/*.yaml",
    "./src/data/schema/abilities-signatures.json": "src/data/abilities/signatures/*.yaml",
    "./src/data/schema/items-records.json": "src/data/items/records/*.yaml",
    "./src/data/schema/items-text.json": "src/data/text/*/items/*.yaml",
    "./src/data/schema/battle-statuses.json": "src/data/battle/statuses.yaml",
    "./src/data/schema/battle-added-statuses.json": "src/data/battle/added-statuses.yaml",
    "./src/data/schema/battle-added-stages.json": "src/data/battle/added-stages.yaml",
    "./src/data/schema/battle-stages.json": "src/data/battle/stages.yaml",
    "./src/data/schema/battle-multi-hit.json": "src/data/battle/multi-hit.yaml",
    "./src/data/schema/battle-share.json": [
      "src/data/battle/recoil.yaml",
      "src/data/battle/drain.yaml",
      "src/data/battle/heal.yaml"
    ],
    "./src/data/schema/battle-z-power.json": "src/data/battle/z-power.yaml",
    "./src/data/schema/biome-pools.json": "src/data/biome/pools/*.yaml"
  }
}
