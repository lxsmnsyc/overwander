# Firebase web app config (public by design): Firebase console ->
# project settings -> your web app. Copy to .env and fill in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# The overworld seed every player shares; defaults to 'overworld'
VITE_WORLD_SEED=

# Server only, and secret: the service account the privileged writes
# run as. Firebase console -> project settings -> service accounts ->
# generate new private key, then paste the whole JSON on one line.
# Leave it empty to fall back to application default credentials
# (GOOGLE_APPLICATION_CREDENTIALS, or a Google-hosted runtime).
#
# Without it, every write refuses: catches, gold, items, candy,
# evolutions, landmark claims and raid rewards all go through
# src/server/* and none of them can reach Firestore unauthenticated.
FIREBASE_SERVICE_ACCOUNT=
